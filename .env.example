# Example placeholders only. Replace all passwords and the signing key before use.
ASPNETCORE_ENVIRONMENT=Development
SQLSERVER_PASSWORD=Replace_TripDB_Passw0rd!
POSTGRES_USER=swiftride
POSTGRES_PASSWORD=Replace_PayDB_Passw0rd
# Supabase direct PostgreSQL connection for PaymentService (Npgsql format).
# Use a LOGIN user granted swiftride_payment, not the NOLOGIN group role itself.
# Database=postgres is the database; paydb is the schema, not the database name.
# Replace both credential placeholders; never commit real credentials.
# Export this variable for dotnet: .NET does not automatically load .env files.
# Current docker-compose.yml sets its own local connection string and does not use this override yet.
ConnectionStrings__PaymentDB=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.ywcbecxxhktumyqumwdc;Password=khFcSN1Spu01De0M;SSL Mode=Disable;Timeout=15;Command Timeout=30
RABBITMQ_USER=swiftride
RABBITMQ_PASSWORD=Replace_Messaging_Passw0rd
JWT_ISSUER=swiftride-development
JWT_AUDIENCE=swiftride-clients
JWT_SIGNING_KEY=Replace_With_A_Unique_Key_At_Least_32_Bytes!
TRIP_SERVICE_ADDRESS=http://trip-service:8080/
MATCHING_SERVICE_ADDRESS=http://matching-service:8080/
RATE_LIMIT_PERMIT_LIMIT=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_QUEUE_LIMIT=0

# Matching owns only matchdb; provision a dedicated login with swiftride_matching membership.
ConnectionStrings__MatchDB=Host=YOUR_SUPABASE_POOLER;Port=5432;Database=postgres;Username=YOUR_MATCHING_LOGIN;Password=REPLACE_LOCALLY;SSL Mode=VerifyFull;Timeout=15;Command Timeout=30
GEOCODING_SEARCH_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=SwiftRideCourseDemo/1.0
MATCHING_SEED_DEMO_DRIVERS=false