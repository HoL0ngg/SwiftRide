{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "ReverseProxy": {
    "Routes": {
      "trips": {
        "ClusterId": "trip-service",
        "AuthorizationPolicy": "public",
        "Match": { "Path": "/trips/{**catch-all}" }
      },
      "driver-location": {
        "ClusterId": "matching-service",
        "AuthorizationPolicy": "public",
        "Match": { "Path": "/drivers/{id}/location", "Methods": ["PUT"] }
      }
    },
    "Clusters": {
      "trip-service": { "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "primary": {} } },
      "matching-service": { "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "primary": {} } }
    }
  }
}
