{
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": false,
        "TimestampFormat": "HH:mm:ss.fff "
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Matching": {
    "RadiusKm": 5,
    "LocationMaxAgeSeconds": 300,
    "AverageSpeedKph": 25,
    "CostPerKm": 7500,
    "CostPerMinute": 300,
    "CarCostPerKm": 15000,
    "CarCostPerMinute": 600,
    "Surge": 1,
    "NightMultiplier": 1.2,
    "Toll": 0,
    "PromotionFactor": 1,
    "Tax": 0,
    "Rounding": "AwayFromZero"
  },
  "Geocoding": {
    "SearchUrl": "https://nominatim.openstreetmap.org/search",
    "UserAgent": "SwiftRideCourseDemo/1.0"
  }
}
