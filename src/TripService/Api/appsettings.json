{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Messaging": {
    "Transport": "None"
  },
  "TripLifecycle": {
    "MaxDriverRejections": 3,
    "SupportedPricingModes": [ "standard" ],
    "PaymentTransport": "Rest"
  },
  "TripRecovery": {
    "MatchingMaxAttempts": 5,
    "MatchingLeaseDuration": "00:00:30",
    "MatchingTimeout": "00:00:05"
  },
  "PaymentWorkflow": {
    "MaxAttempts": 20,
    "TotalBudget": "00:10:00",
    "InitialBackoff": "00:00:02",
    "MaxBackoff": "00:01:00",
    "DefaultCardAlias": "card.success.v1",
    "DefaultWalletAlias": "wallet.success.v1"
  }
}
