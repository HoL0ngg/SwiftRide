{
  "info": {
    "name": "SwiftRide RabbitMQ Observe",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Operator-only Management API, separate from client traffic. Run Setup BEFORE Gateway demo; then Read manually or inspect UI. Do not run Cleanup before inspecting. Receives copies without consuming business queues. Credentials belong in a local environment; do not export them. Queue/messages expire after one hour."
  },
  "variable": [
    {
      "key": "rabbitmq_url",
      "value": "http://localhost:15672"
    },
    {
      "key": "observer_queue",
      "value": "demo-observe-postman"
    }
  ],
  "item": [
    {
      "name": "01 Setup - run before demo",
      "item": [
        {
          "name": "01 Create observation queue",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitmq_user}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rabbitmq_password}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{rabbitmq_url}}/api/queues/%2F/{{observer_queue}}",
            "description": "Run the entire scenario folder in order. See docs/postman-demo.md. English script names identify assertions in Runner.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"durable\": false,\n  \"auto_delete\": false,\n  \"arguments\": {\n    \"x-expires\": 3600000,\n    \"x-message-ttl\": 3600000\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('rabbitmq_user') || !pm.variables.get('rabbitmq_password')) throw new Error('Set rabbitmq_user and rabbitmq_password in a local Postman environment.');",
                  "if (!/^demo-observe-[a-zA-Z0-9-]+$/.test(pm.variables.get('observer_queue') || '')) throw new Error('observer_queue must start with demo-observe- and contain only letters, digits and hyphens.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(pm.info.requestName, function () {",
                  "  try {",
                  "pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
                  "  } catch (error) { pm.execution.setNextRequest(null); throw error; }",
                  "});"
                ]
              }
            }
          ]
        },
