    {
      "name": "02 Read - run after demo",
      "item": [
        {
          "name": "15 Read captured messages (requeue)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitmq_user}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rabbitmq_password}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{rabbitmq_url}}/api/queues/%2F/{{observer_queue}}/get",
            "description": "Run the entire scenario folder in order. See docs/postman-demo.md. English script names identify assertions in Runner.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"count\": 100,\n  \"ackmode\": \"ack_requeue_true\",\n  \"encoding\": \"auto\",\n  \"truncate\": 100000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!/^demo-observe-[a-zA-Z0-9-]+$/.test(pm.variables.get('observer_queue') || '')) throw new Error('Only demo-observe-* queues are allowed.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(pm.info.requestName, function () {",
                  "  try {",
                  "pm.expect(pm.response.code).to.eql(200);",
                  "const messages = pm.response.json();",
                  "pm.expect(messages).to.be.an('array');",
                  "messages.forEach(entry => {",
                  "  let payload;",
                  "  try { payload = JSON.parse(entry.payload); } catch (_) { return; }",
                  "  const message = payload.message || {};",
                  "  console.log(entry.exchange, { tripId: message.tripId, eventId: message.eventId, failureCode: message.failureCode });",
                  "});",
                  "  } catch (error) { pm.execution.setNextRequest(null); throw error; }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Cleanup - run after inspection",
      "item": [
        {
          "name": "16 Delete observation queue only",
          "request": {
            "method": "DELETE",
            "header": [],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitmq_user}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rabbitmq_password}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{rabbitmq_url}}/api/queues/%2F/{{observer_queue}}",
            "description": "Run the entire scenario folder in order. See docs/postman-demo.md. English script names identify assertions in Runner."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!/^demo-observe-[a-zA-Z0-9-]+$/.test(pm.variables.get('observer_queue') || '')) throw new Error('Only demo-observe-* queues are allowed.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(pm.info.requestName, function () {",
                  "  try {",
                  "pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
                  "  } catch (error) { pm.execution.setNextRequest(null); throw error; }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
