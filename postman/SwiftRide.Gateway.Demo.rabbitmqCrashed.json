            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(pm.info.requestName, function () {",
                  "  try {",
                  "pm.expect(pm.response.code).to.eql(200);",
                  "const trip = pm.response.json();",
                  "pm.expect(trip.id).to.eql(pm.variables.get('trip_id'));",
                  "pm.expect(trip.fareAmount).to.eql(pm.variables.get('fare_amount'));",
                  "pm.expect(trip.currency).to.eql('VND');",
                  "if (trip.status === 'DriverOffered' && !trip.offeredDriverId) {",
                  "  const count = Number(pm.variables.get('offer_polls') || 0) + 1;",
                  "  pm.variables.set('offer_polls', count);",
                  "  pm.expect(count, 'offer polling limit exceeded').to.be.below(60);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.expect(trip.status).to.eql('DriverOffered');",
                  "  pm.expect(trip.offeredDriverId).to.be.a('string').and.not.empty;",
                  "  const rejected = JSON.parse(pm.variables.get('rejected_driver_ids'));",
                  "  pm.expect(rejected).not.to.include(trip.offeredDriverId);",
                  "  pm.variables.set('offered_driver_id', trip.offeredDriverId);",
                  "}",
                  "  } catch (error) { pm.execution.setNextRequest(null); throw error; }",
                  "});"
                ]
              }
            }
