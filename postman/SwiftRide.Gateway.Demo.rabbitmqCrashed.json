{
  "info": {
    "name": "SwiftRide Gateway Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run each entire folder, one iteration, delay 1000 ms, request timeout 20000 ms. Development only. Default Events requires RabbitMQ on Trip/Matching/Payment. See docs/postman-demo.md. Failure folders intentionally leave unresolved PaymentPending trips. Mock only; no real card data."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5080"
    },
    {
      "key": "payment_transport",
      "value": "Events"
    }
  ],
  "item": [
    {
      "name": "01 Success, idempotency and authorization",
      "item": [
        {
          "name": "01 Start scenario",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/health",
            "description": "Run the entire scenario folder in order. See docs/postman-demo.md. English script names identify assertions in Runner."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = pm.variables.replaceIn('{{$guid}}');",
                  "pm.variables.set('run_id', run);",
                  "pm.variables.set('rider_id', 'pm-01-rider-' + run);",
                  "pm.variables.set('demo_driver_id', 'pm-01-driver-' + run);",
                  "pm.variables.set('latitude', 1);",
                  "pm.variables.set('quote_polls', 0);",
                  "pm.variables.set('offer_polls', 0);",
                  "pm.variables.set('payment_polls', 0);",
                  "pm.variables.set('rejected_driver_ids', '[]');",
                  "pm.variables.unset('trip_id');",
                  "pm.variables.unset('quote_id');",
                  "pm.variables.unset('fare_amount');",
                  "pm.variables.unset('offered_driver_id');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(pm.info.requestName, function () {",
                  "  try {",
                  "pm.expect(pm.response.code).to.eql(200);",
                  "  } catch (error) { pm.execution.setNextRequest(null); throw error; }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01 rider token",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/dev/token?userId={{rider_id}}&role=rider",
            "description": "Run the entire scenario folder in order. See docs/postman-demo.md. English script names identify assertions in Runner."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(pm.info.requestName, function () {",
                  "  try {",
                  "pm.expect(pm.response.code).to.eql(200);",
                  "const token = pm.response.json().access_token;",
                  "pm.expect(token).to.be.a('string').and.not.empty;",
                  "pm.variables.set('rider_token', token);",
                  "  } catch (error) { pm.execution.setNextRequest(null); throw error; }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01.1 driver token",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/dev/token?userId={{demo_driver_id}}&role=driver",
            "description": "Run the entire scenario folder in order. See docs/postman-demo.md. English script names identify assertions in Runner."
