                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01.1 Driver online",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{demo_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/drivers/{{demo_driver_id}}/location",
            "description": "Run the entire scenario folder in order. See docs/postman-demo.md. English script names identify assertions in Runner.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": {{latitude}},\n  \"longitude\": -140,\n  \"isOnline\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(pm.info.requestName, function () {",
                  "  try {",
                  "pm.expect(pm.response.code).to.eql(204);",
                  "  } catch (error) { pm.execution.setNextRequest(null); throw error; }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01 Create trip",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rider_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{run_id}}-create"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/trips",
            "description": "Run the entire scenario folder in order. See docs/postman-demo.md. English script names identify assertions in Runner.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\n    \"latitude\": {{latitude}},\n    \"longitude\": -140\n  },\n  \"pickupName\": \"Postman demo pickup\",\n  \"destination\": {\n    \"latitude\": {{latitude}},\n    \"longitude\": -139.99\n  },\n  \"destinationName\": \"Postman demo destination\",\n  \"paymentMethod\": \"wallet\",\n  \"mode\": \"standard\",\n  \"paymentTransport\": \"{{payment_transport}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(pm.info.requestName, function () {",
                  "  try {",
                  "pm.expect(pm.response.code).to.be.oneOf([201, 202]);",
                  "const trip = pm.response.json();",
                  "pm.expect(trip.id).to.be.a('string').and.not.empty;",
                  "pm.variables.set('trip_id', trip.id);",
                  "pm.expect(trip.status).to.be.oneOf(['Requested', 'Quoted', 'Failed']);",
                  "  } catch (error) { pm.execution.setNextRequest(null); throw error; }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01 Wait for Quoted",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rider_token}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/trips/{{trip_id}}",
            "description": "Run the entire scenario folder in order. See docs/postman-demo.md. English script names identify assertions in Runner."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(pm.info.requestName, function () {",
                  "  try {",
                  "pm.expect(pm.response.code).to.eql(200);",
                  "const trip = pm.response.json();",
                  "pm.expect(trip.id).to.eql(pm.variables.get('trip_id'));",
                  "if (trip.status === 'Requested') {",
                  "  const count = Number(pm.variables.get('quote_polls') || 0) + 1;",
                  "  pm.variables.set('quote_polls', count);",
                  "  pm.expect(count, 'quote polling limit exceeded').to.be.below(60);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.expect(trip.status).to.eql('Quoted');",
                  "  pm.expect(trip.quoteId).to.be.a('string').and.not.empty;",
                  "  pm.expect(trip.fareAmount).to.match(/^[0-9]+$/);",
                  "  pm.expect(trip.currency).to.eql('VND');",
                  "  pm.variables.set('quote_id', trip.quoteId);",
                  "  pm.variables.set('fare_amount', trip.fareAmount);",
                  "}",
                  "  } catch (error) { pm.execution.setNextRequest(null); throw error; }",
                  "});"
                ]
              }
            }
          ]
        },
