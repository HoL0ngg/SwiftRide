          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{rider_token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{base_url}}/trips",
        "description": "See docs/api-reference.md. Run in collection order.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pickup\": {\n    \"latitude\": 10.7725,\n    \"longitude\": 106.698\n  },\n  \"pickupName\": \"Chợ Bến Thành\",\n  \"pickupAddress\": \"Quận 1\",\n  \"destination\": {\n    \"latitude\": 10.7951,\n    \"longitude\": 106.7219\n  },\n  \"destinationName\": \"Landmark 81\",\n  \"destinationAddress\": \"Bình Thạnh\",\n  \"paymentMethod\": \"wallet\",\n  \"mode\": \"standard\",\n  \"paymentTransport\": \"Rest\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"07 Create trip\", function () {",
              "  try {",
              "pm.expect(pm.response.code).to.be.oneOf([201, 202]);",
              "const trip = pm.response.json();",
              "pm.expect(trip.id).to.be.a('string').and.not.empty;",
              "pm.expect(trip.status).to.be.oneOf(['Requested', 'Quoted']);",
              "pm.variables.set('trip_id', trip.id);",
              "  } catch (error) {",
              "    pm.execution.setNextRequest(null);",
              "    throw error;",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Wait for quote",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{rider_token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{base_url}}/trips/{{trip_id}}",
        "description": "See docs/api-reference.md. Run in collection order."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"08 Wait for quote\", function () {",
              "  try {",
              "pm.expect(pm.response.code).to.eql(200);",
              "const trip = pm.response.json();",
              "pm.expect(trip.id).to.eql(pm.variables.get('trip_id'));",
              "pm.expect(trip.status).to.be.oneOf(['Requested', 'Quoted']);",
              "if (trip.status === 'Requested') {",
              "  const count = Number(pm.variables.get('quote_polls')) + 1;",
              "  pm.variables.set('quote_polls', count);",
              "  pm.expect(count, 'Quote polling limit exceeded').to.be.below(30);",
              "  pm.execution.setNextRequest(pm.info.requestName);",
              "} else {",
              "  pm.expect(trip.quoteId).to.be.a('string').and.not.empty;",
              "  pm.expect(trip.fareAmount).to.match(/^\\d+$/);",
              "  pm.expect(trip.currency).to.eql('VND');",
              "  pm.variables.set('quote_id', trip.quoteId);",
              "  pm.variables.set('fare_amount', trip.fareAmount);",
              "}",
              "  } catch (error) {",
              "    pm.execution.setNextRequest(null);",
              "    throw error;",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
