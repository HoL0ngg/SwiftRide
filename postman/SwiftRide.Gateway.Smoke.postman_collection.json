{
  "info": {
    "name": "SwiftRide Gateway Smoke",
    "description": "DevelopmentJwt smoke test through YARP only. See docs/api-reference.md. Creates demo records using mock payments. Run all requests in order, one iteration, delay 1000 ms, request timeout 15000 ms. Tokens are run-local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{base_url}}/health",
        "description": "See docs/api-reference.md. Run in collection order."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = pm.variables.replaceIn('{{$guid}}');",
              "pm.variables.set('rider_id', 'pm-rider-' + runId);",
              "pm.variables.set('driver_id', 'pm-driver-' + runId);",
              "pm.variables.set('create_key', 'create-' + runId);",
              "pm.variables.set('dropoff_key', 'dropoff-' + runId);",
              "pm.variables.set('quote_polls', 0);",
              "pm.variables.set('paid_polls', 0);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"01 Health\", function () {",
              "  try {",
              "pm.expect(pm.response.code).to.eql(200);",
              "  } catch (error) {",
              "    pm.execution.setNextRequest(null);",
              "    throw error;",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Rider token",
      "request": {
        "method": "POST",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{base_url}}/dev/token?userId={{rider_id}}&role=rider",
        "description": "See docs/api-reference.md. Run in collection order."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"02 Rider token\", function () {",
              "  try {",
              "pm.expect(pm.response.code).to.eql(200);",
              "const token = pm.response.json().access_token;",
              "pm.expect(token).to.be.a('string').and.not.empty;",
              "pm.variables.set('rider_token', token);",
              "  } catch (error) {",
              "    pm.execution.setNextRequest(null);",
              "    throw error;",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
