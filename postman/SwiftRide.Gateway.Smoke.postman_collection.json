    {
      "name": "07 Create trip",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{create_key}}"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{rider_token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{base_url}}/trips",
        "description": "See docs/api-reference.md section 7. Select a Postman environment. Send independently with saved tokens and trip data, or use Collection Runner for the full workflow.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pickup\": {\n    \"latitude\": 10.7725,\n    \"longitude\": 106.698\n  },\n  \"pickupName\": \"Chợ Bến Thành\",\n  \"pickupAddress\": \"Quận 1\",\n  \"destination\": {\n    \"latitude\": 10.7951,\n    \"longitude\": 106.7219\n  },\n  \"destinationName\": \"Landmark 81\",\n  \"destinationAddress\": \"Bình Thạnh\",\n  \"paymentMethod\": \"wallet\",\n  \"mode\": \"standard\",\n  \"paymentTransport\": \"Events\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"07 Create trip\", function () {",
              "  try {",
              "pm.expect(pm.response.code, 'Expected 202 for event matching or 200 for a known replay; 201 indicates synchronous matching').to.be.oneOf([200, 202]);",
              "const trip = pm.response.json();",
              "pm.expect(trip.id).to.be.a('string').and.not.empty;",
              "if (pm.response.code === 200) {",
              "  pm.expect(trip.id, 'Replay must match trip_id saved in the selected environment').to.eql(pm.environment.get('trip_id'));",
              "  pm.expect(trip.status).to.be.oneOf(['Quoted', 'DriverOffered', 'DriverAccepted', 'EnRoute', 'PickedUp', 'DroppedOff', 'PaymentPending', 'Paid', 'Cancelled', 'Failed']);",
              "} else {",
              "  pm.expect(trip.status).to.eql('Requested');",
              "}",
              "pm.environment.set('trip_id', trip.id);",
              "  } catch (error) {",
              "    pm.execution.setNextRequest(null);",
              "    throw error;",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Wait for quote",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{rider_token}}",
              "type": "string"
            }
