    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.id) {",
          "  throw new Error('Select a Postman environment before sending requests.');",
          "}",
          "for (const [key, prefix] of [['rider_id', 'pm-rider-'], ['driver_id', 'pm-driver-'], ['create_key', 'create-'], ['dropoff_key', 'dropoff-']]) {",
          "  if (!pm.environment.get(key)) {",
          "    pm.environment.set(key, prefix + pm.variables.replaceIn('{{$guid}}'));",
          "  }",
          "}"
        ]
      }
    }
