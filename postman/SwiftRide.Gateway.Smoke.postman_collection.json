        },
        "url": "{{base_url}}/trips/{{trip_id}}",
        "description": "See docs/api-reference.md section 7. Select a Postman environment. Send independently with saved tokens and trip data, or use Collection Runner for the full workflow."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"08 Wait for quote\", function () {",
              "  try {",
              "pm.expect(pm.response.code).to.eql(200);",
              "const trip = pm.response.json();",
              "pm.expect(trip.id).to.eql(pm.environment.get('trip_id'));",
              "pm.expect(trip.status).to.be.oneOf(['Requested', 'Quoted']);",
              "if (trip.status === 'Requested') {",
              "  const count = Number(pm.variables.get('quote_polls') || 0) + 1;",
              "  pm.variables.set('quote_polls', count);",
              "  pm.expect(count, 'Quote polling limit exceeded').to.be.below(30);",
              "  pm.execution.setNextRequest(pm.info.requestName);",
              "} else {",
              "  pm.expect(trip.quoteId).to.be.a('string').and.not.empty;",
              "  pm.expect(trip.fareAmount).to.match(/^\\d+$/);",
              "  pm.expect(trip.currency).to.eql('VND');",
              "  pm.environment.set('quote_id', trip.quoteId);",
              "  pm.environment.set('fare_amount', trip.fareAmount);",
              "}",
              "  } catch (error) {",
              "    pm.execution.setNextRequest(null);",
              "    throw error;",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
